{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpay.dev/schemas/x402-escrow-deployment-v1.schema.json",
  "title": "AgentPay x402 Escrow Deployment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "protocol",
    "schemaVersion",
    "abiVersion",
    "chainId",
    "network",
    "asset",
    "factoryAddress",
    "implementationAddress",
    "factorySourceCommit",
    "deploymentTxHash",
    "deploymentBlockNumber",
    "deployedAt",
    "compiler",
    "bytecode",
    "auditStatus"
  ],
  "properties": {
    "schema": { "const": "agentpay.x402-escrow-deployment.v1" },
    "status": { "enum": ["canonical", "deprecated"] },
    "protocol": { "const": "agentpay.x402.escrow.v1" },
    "schemaVersion": { "const": "1.0.0" },
    "abiVersion": { "const": "1.0.0" },
    "chainId": { "const": "8453" },
    "network": { "const": "eip155:8453" },
    "asset": { "pattern": "^0x[0-9a-fA-F]{40}$" },
    "factoryAddress": { "pattern": "^0x[0-9a-fA-F]{40}$" },
    "implementationAddress": { "pattern": "^0x[0-9a-fA-F]{40}$" },
    "factorySourceCommit": { "pattern": "^[0-9a-f]{40}$" },
    "deploymentTxHash": { "pattern": "^0x[0-9a-fA-F]{64}$" },
    "deploymentBlockNumber": { "type": "string", "pattern": "^[0-9]+$" },
    "deployedAt": { "type": "string", "format": "date-time" },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solc", "optimizer", "optimizerRuns", "viaIR", "evmVersion"],
      "properties": {
        "solc": { "const": "0.8.24" },
        "optimizer": { "const": true },
        "optimizerRuns": { "const": 200 },
        "viaIR": { "const": true },
        "evmVersion": { "const": "cancun" }
      }
    },
    "bytecode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factoryCreationKeccak256",
        "factoryRuntimeKeccak256",
        "implementationRuntimeKeccak256"
      ],
      "properties": {
        "factoryCreationKeccak256": { "pattern": "^0x[0-9a-fA-F]{64}$" },
        "factoryRuntimeKeccak256": { "pattern": "^0x[0-9a-fA-F]{64}$" },
        "implementationRuntimeKeccak256": { "pattern": "^0x[0-9a-fA-F]{64}$" }
      }
    },
    "auditStatus": { "enum": ["not-audited", "audit-in-progress", "audited"] }
  }
}
