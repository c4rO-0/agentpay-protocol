{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpay.dev/schemas/agentpay-safe-module-v1.schema.json",
  "title": "AgentPay Safe Module x402 Binding v1",
  "$defs": {
    "EvmAddress": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "Bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "AtomicAmount": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "UnixSeconds": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "Signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]{130}$" },
    "AgentPayRegistryQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "skillId", "profileHash", "seller"],
      "properties": {
        "registry": { "$ref": "#/$defs/EvmAddress" },
        "skillId": { "$ref": "#/$defs/Bytes32" },
        "profileHash": { "$ref": "#/$defs/Bytes32" },
        "seller": { "$ref": "#/$defs/EvmAddress" }
      }
    },
    "AgentPaySpendingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "delegate", "token", "factory", "registry", "maxPerPayment", "totalBudget", "validAfter", "validUntil"],
      "properties": {
        "policyId": { "$ref": "#/$defs/Bytes32" },
        "delegate": { "$ref": "#/$defs/EvmAddress" },
        "token": { "$ref": "#/$defs/EvmAddress" },
        "factory": { "$ref": "#/$defs/EvmAddress" },
        "registry": { "$ref": "#/$defs/EvmAddress" },
        "maxPerPayment": { "$ref": "#/$defs/AtomicAmount" },
        "totalBudget": { "$ref": "#/$defs/AtomicAmount" },
        "validAfter": { "$ref": "#/$defs/UnixSeconds" },
        "validUntil": { "$ref": "#/$defs/UnixSeconds" }
      }
    },
    "AgentPayPaymentRequirementsExtra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "paymentFlow", "module", "safe", "policyId", "factory", "orderId", "termsHash", "scopeProofHash"],
      "properties": {
        "binding": { "const": "agentpay.safe-module.v1" },
        "paymentFlow": { "const": "escrow" },
        "module": { "$ref": "#/$defs/EvmAddress" },
        "safe": { "$ref": "#/$defs/EvmAddress" },
        "policyId": { "$ref": "#/$defs/Bytes32" },
        "factory": { "$ref": "#/$defs/EvmAddress" },
        "orderId": { "$ref": "#/$defs/Bytes32" },
        "termsHash": { "$ref": "#/$defs/Bytes32" },
        "scopeProofHash": { "$ref": "#/$defs/Bytes32" }
      }
    },
    "AgentPayPaymentRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "network", "asset", "amount", "payTo", "maxTimeoutSeconds", "extra"],
      "properties": {
        "scheme": { "const": "agentpay" },
        "network": { "type": "string", "pattern": "^eip155:[1-9][0-9]*$" },
        "asset": { "$ref": "#/$defs/EvmAddress" },
        "amount": { "$ref": "#/$defs/AtomicAmount" },
        "payTo": { "$ref": "#/$defs/EvmAddress" },
        "maxTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "extra": { "$ref": "#/$defs/AgentPayPaymentRequirementsExtra" }
      }
    },
    "AgentPayCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "safe", "policyId", "factory", "orderId", "vault", "token", "amount", "termsHash", "scopeProofHash", "commitmentNonce", "validBefore"],
      "properties": {
        "binding": { "const": "agentpay.safe-module.v1" },
        "safe": { "$ref": "#/$defs/EvmAddress" },
        "policyId": { "$ref": "#/$defs/Bytes32" },
        "factory": { "$ref": "#/$defs/EvmAddress" },
        "orderId": { "$ref": "#/$defs/Bytes32" },
        "vault": { "$ref": "#/$defs/EvmAddress" },
        "token": { "$ref": "#/$defs/EvmAddress" },
        "amount": { "$ref": "#/$defs/AtomicAmount" },
        "termsHash": { "$ref": "#/$defs/Bytes32" },
        "scopeProofHash": { "$ref": "#/$defs/Bytes32" },
        "commitmentNonce": { "$ref": "#/$defs/Bytes32" },
        "validBefore": { "$ref": "#/$defs/UnixSeconds" }
      }
    },
    "AgentPayPaymentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x402Version", "accepted", "payload"],
      "properties": {
        "x402Version": { "const": 2 },
        "accepted": { "$ref": "#/$defs/AgentPayPaymentRequirements" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commitment", "signature"],
          "properties": {
            "commitment": { "$ref": "#/$defs/AgentPayCommitment" },
            "signature": { "$ref": "#/$defs/Signature" }
          }
        },
        "extensions": { "type": "object" }
      }
    },
    "AgentPayResultExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "paymentFlow", "commitmentId", "orderId", "vault"],
      "properties": {
        "binding": { "const": "agentpay.safe-module.v1" },
        "paymentFlow": { "const": "escrow" },
        "commitmentId": { "$ref": "#/$defs/Bytes32" },
        "orderId": { "$ref": "#/$defs/Bytes32" },
        "vault": { "$ref": "#/$defs/EvmAddress" }
      }
    },
    "AgentPayVerifyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isValid"],
      "properties": {
        "isValid": { "type": "boolean" },
        "invalidReason": { "type": "string" },
        "invalidMessage": { "type": "string" },
        "payer": { "$ref": "#/$defs/EvmAddress" },
        "extensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentpay"],
          "properties": { "agentpay": { "$ref": "#/$defs/AgentPayResultExtension" } }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "isValid": { "const": true } }, "required": ["isValid"] },
          "then": {
            "properties": { "payer": {}, "extensions": {} },
            "required": ["payer", "extensions"]
          },
          "else": {
            "properties": { "invalidReason": {} },
            "required": ["invalidReason"]
          }
        }
      ]
    },
    "AgentPayCommitmentAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "accepted", "commitmentId", "orderId", "status", "acceptedAt"],
      "properties": {
        "schema": { "const": "agentpay.commitment-acceptance.v1" },
        "accepted": { "const": true },
        "commitmentId": { "$ref": "#/$defs/Bytes32" },
        "orderId": { "$ref": "#/$defs/Bytes32" },
        "status": { "const": "accepted" },
        "acceptedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" }
      }
    },
    "AgentPaySettleResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "transaction", "network"],
      "properties": {
        "success": { "type": "boolean" },
        "errorReason": { "type": "string" },
        "errorMessage": { "type": "string" },
        "payer": { "$ref": "#/$defs/EvmAddress" },
        "transaction": { "type": "string", "pattern": "^(0x[0-9a-f]{64})?$" },
        "network": { "type": "string", "pattern": "^eip155:[1-9][0-9]*$" },
        "amount": { "$ref": "#/$defs/AtomicAmount" },
        "extensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agentpay"],
          "properties": {
            "agentpay": {
              "type": "object",
              "additionalProperties": false,
              "required": ["binding", "paymentFlow", "commitmentId", "orderId", "vault", "fundingEvidence"],
              "properties": {
                "binding": { "const": "agentpay.safe-module.v1" },
                "paymentFlow": { "const": "escrow" },
                "commitmentId": { "$ref": "#/$defs/Bytes32" },
                "orderId": { "$ref": "#/$defs/Bytes32" },
                "vault": { "$ref": "#/$defs/EvmAddress" },
                "fundingEvidence": { "const": "confirmed" }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "success": { "const": true } }, "required": ["success"] },
          "then": {
            "required": ["payer", "amount", "extensions"],
            "properties": {
              "payer": {},
              "amount": {},
              "extensions": {},
              "transaction": { "$ref": "#/$defs/Bytes32" }
            }
          },
          "else": {
            "required": ["errorReason"],
            "properties": { "errorReason": {}, "transaction": { "const": "" } }
          }
        }
      ]
    }
  }
}
