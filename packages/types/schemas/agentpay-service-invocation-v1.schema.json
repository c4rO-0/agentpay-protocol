{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpay.dev/schemas/agentpay-service-invocation-v1.schema.json",
  "title": "AgentPay JSON service invocation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "orderId",
    "requestHash",
    "request"
  ],
  "properties": {
    "version": {
      "const": "agentpay.service-invocation.v1"
    },
    "orderId": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "requestHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "request": {}
  }
}
