{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpay.dev/schemas/agentpay-service-payment-required-v1.schema.json",
  "title": "AgentPay Service Payment Required v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "resource",
    "requirement"
  ],
  "properties": {
    "version": {
      "const": "agentpay.service-payment-required.v1"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "method"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Z]+$"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "network",
        "asset",
        "skillId",
        "profileHash",
        "seller",
        "baseAmount",
        "unitPrice",
        "maxUsageUnits",
        "offerId",
        "validUntil"
      ],
      "properties": {
        "scheme": {
          "const": "agentpay"
        },
        "network": {
          "type": "string",
          "pattern": "^eip155:[1-9][0-9]*$"
        },
        "asset": {
          "$ref": "#/$defs/address"
        },
        "skillId": {
          "$ref": "#/$defs/bytes32"
        },
        "profileHash": {
          "$ref": "#/$defs/bytes32"
        },
        "seller": {
          "$ref": "#/$defs/address"
        },
        "baseAmount": {
          "$ref": "#/$defs/uintString"
        },
        "unitPrice": {
          "$ref": "#/$defs/uintString"
        },
        "maxUsageUnits": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "offerId": {
          "$ref": "#/$defs/bytes32"
        },
        "validUntil": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "serviceWindowSeconds": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "description": "Maximum delivery duration from Order creation, in seconds; not Quote validity."
        }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "uintString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  }
}
