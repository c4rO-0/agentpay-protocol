{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpay.dev/schemas/agentpay-service-profile-v1.schema.json",
  "title": "AgentPay Service Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providerId", "serviceId", "mcpEndpoint", "paymentEndpoint", "seller", "network", "asset"],
  "properties": {
    "version": { "const": "agentpay.service-profile.v1" },
    "providerId": { "type": "string", "pattern": "^provider:[A-Za-z0-9:._-]{1,183}$" },
    "serviceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,190}$" },
    "mcpEndpoint": { "type": "string", "minLength": 1, "description": "Canonical controlled HTTP or HTTPS service URL; optional safe path prefix precedes /services/<serviceId>/mcp/invoke. Runtime canonicalization enforces the path." },
    "paymentEndpoint": { "type": "string", "minLength": 1 },
    "seller": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "network": { "type": "string", "pattern": "^eip155:[1-9][0-9]*$" },
    "asset": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
  }
}
