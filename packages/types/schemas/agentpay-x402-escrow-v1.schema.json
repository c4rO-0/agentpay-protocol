{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpay.dev/schemas/agentpay-x402-escrow-v1.schema.json",
  "title": "AgentPay x402 Escrow Protocol v1",
  "$defs": {
    "EvmAddress": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "Bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "AtomicAmount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "IsoDateTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "PaymentRail": {
      "type": "string",
      "enum": ["safe_allowance_deal_manager", "x402_exact_escrow"]
    },
    "EscrowVaultState": {
      "type": "string",
      "enum": ["Uninitialized", "Created", "Funded", "Delivered", "Released", "Refunded", "Cancelled"]
    },
    "EscrowOrderTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "paymentRail", "chainId", "factoryAddress", "orderId", "buyer", "seller", "token", "settlementAuthority", "feeRecipient", "amount", "maxFeeAmount", "expiresAt", "refundAvailableAt"],
      "properties": {
        "protocol": { "const": "agentpay.x402.escrow.v1" },
        "paymentRail": { "const": "x402_exact_escrow" },
        "chainId": { "$ref": "#/$defs/AtomicAmount" },
        "factoryAddress": { "$ref": "#/$defs/EvmAddress" },
        "orderId": { "$ref": "#/$defs/Bytes32" },
        "buyer": { "$ref": "#/$defs/EvmAddress" },
        "seller": { "$ref": "#/$defs/EvmAddress" },
        "token": { "$ref": "#/$defs/EvmAddress" },
        "settlementAuthority": { "$ref": "#/$defs/EvmAddress" },
        "feeRecipient": { "$ref": "#/$defs/EvmAddress" },
        "amount": { "$ref": "#/$defs/AtomicAmount" },
        "maxFeeAmount": { "$ref": "#/$defs/AtomicAmount" },
        "expiresAt": { "$ref": "#/$defs/AtomicAmount" },
        "refundAvailableAt": { "$ref": "#/$defs/AtomicAmount" }
      }
    },
    "X402PaymentRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "network", "asset", "amount", "payTo", "maxTimeoutSeconds", "extra", "extensions"],
      "properties": {
        "scheme": { "const": "exact" },
        "network": { "type": "string", "pattern": "^eip155:(0|[1-9][0-9]*)$" },
        "asset": { "$ref": "#/$defs/EvmAddress" },
        "amount": { "$ref": "#/$defs/AtomicAmount" },
        "payTo": { "$ref": "#/$defs/EvmAddress" },
        "maxTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "extra": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version"],
          "properties": { "name": { "const": "USD Coin" }, "version": { "const": "2" } }
        },
        "extensions": {
          "type": "object", "additionalProperties": true,
          "required": ["agentpay-order", "payment-identifier"],
          "properties": {
            "agentpay-order": {
              "type": "object", "additionalProperties": false,
              "required": ["version", "rail", "orderId", "vault", "buyer", "seller", "termsHash"],
              "properties": {
                "version": { "const": "1" }, "rail": { "const": "x402_exact_escrow" },
                "orderId": { "$ref": "#/$defs/Bytes32" }, "vault": { "$ref": "#/$defs/EvmAddress" },
                "buyer": { "$ref": "#/$defs/EvmAddress" }, "seller": { "$ref": "#/$defs/EvmAddress" },
                "termsHash": { "$ref": "#/$defs/Bytes32" }
              }
            },
            "payment-identifier": {
              "type": "object", "additionalProperties": false, "required": ["id"],
              "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 200 } }
            }
          }
        }
      }
    },
    "X402SettlementEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["network", "asset", "transactionHash", "receiptStatus", "transfer", "observedVaultBalance"],
      "properties": {
        "network": { "type": "string", "pattern": "^eip155:(0|[1-9][0-9]*)$" },
        "asset": { "$ref": "#/$defs/EvmAddress" },
        "transactionHash": { "$ref": "#/$defs/Bytes32" },
        "receiptStatus": { "type": "string", "enum": ["success", "reverted"] },
        "transfer": {
          "type": "object", "additionalProperties": false, "required": ["from", "to", "value"],
          "properties": {
            "from": { "$ref": "#/$defs/EvmAddress" }, "to": { "$ref": "#/$defs/EvmAddress" },
            "value": { "$ref": "#/$defs/AtomicAmount" }
          }
        },
        "observedVaultBalance": { "$ref": "#/$defs/AtomicAmount" }
      }
    },
    "EscrowFundingRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "paymentRail", "orderId", "termsHash", "vaultAddress", "x402PaymentIdentifier", "evidence", "vaultState", "activatedTxHash", "fundingVerifiedAt"],
      "properties": {
        "schema": { "const": "agentpay.x402-escrow-funding.v1" }, "paymentRail": { "const": "x402_exact_escrow" },
        "orderId": { "$ref": "#/$defs/Bytes32" }, "termsHash": { "$ref": "#/$defs/Bytes32" },
        "vaultAddress": { "$ref": "#/$defs/EvmAddress" }, "x402PaymentIdentifier": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/X402SettlementEvidence" }, "vaultState": { "const": "Funded" },
        "activatedTxHash": { "$ref": "#/$defs/Bytes32" }, "fundingVerifiedAt": { "$ref": "#/$defs/IsoDateTime" }
      }
    },
    "EscrowReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "paymentRail", "orderId", "vaultAddress", "outputHash", "usageUnits", "deliveryTxHash", "createdAt"],
      "properties": {
        "schema": { "const": "agentpay.x402-escrow-receipt.v1" }, "paymentRail": { "const": "x402_exact_escrow" },
        "orderId": { "$ref": "#/$defs/Bytes32" }, "vaultAddress": { "$ref": "#/$defs/EvmAddress" },
        "outputHash": { "$ref": "#/$defs/Bytes32" }, "usageUnits": { "$ref": "#/$defs/AtomicAmount" },
        "deliveryTxHash": { "$ref": "#/$defs/Bytes32" }, "createdAt": { "$ref": "#/$defs/IsoDateTime" }
      }
    },
    "EscrowReleaseRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "paymentRail", "orderId", "vaultAddress", "sellerAmount", "feeAmount", "buyerRefundAmount", "releaseTxHash", "releasedAt"],
      "properties": {
        "schema": { "const": "agentpay.x402-escrow-release.v1" }, "paymentRail": { "const": "x402_exact_escrow" },
        "orderId": { "$ref": "#/$defs/Bytes32" }, "vaultAddress": { "$ref": "#/$defs/EvmAddress" },
        "sellerAmount": { "$ref": "#/$defs/AtomicAmount" }, "feeAmount": { "$ref": "#/$defs/AtomicAmount" },
        "buyerRefundAmount": { "$ref": "#/$defs/AtomicAmount" }, "releaseTxHash": { "$ref": "#/$defs/Bytes32" },
        "releasedAt": { "$ref": "#/$defs/IsoDateTime" }
      }
    },
    "EscrowRefundRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "paymentRail", "orderId", "vaultAddress", "refundAmount", "refundTxHash", "reason", "refundedAt"],
      "properties": {
        "schema": { "const": "agentpay.x402-escrow-refund.v1" }, "paymentRail": { "const": "x402_exact_escrow" },
        "orderId": { "$ref": "#/$defs/Bytes32" }, "vaultAddress": { "$ref": "#/$defs/EvmAddress" },
        "refundAmount": { "$ref": "#/$defs/AtomicAmount" }, "refundTxHash": { "$ref": "#/$defs/Bytes32" },
        "reason": { "type": "string", "enum": ["settlement_authority", "timeout"] },
        "refundedAt": { "$ref": "#/$defs/IsoDateTime" }
      }
    }
  }
}
