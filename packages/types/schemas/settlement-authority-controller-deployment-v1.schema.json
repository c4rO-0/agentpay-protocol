{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpay.dev/schemas/settlement-authority-controller-deployment-v1.schema.json",
  "title": "AgentPay Settlement Authority Controller Deployment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "protocol", "abiVersion", "chainId", "network",
    "controllerAddress", "administratorSafe", "factoryAddress",
    "initialExecutor", "sourceCommit", "deploymentTxHash", "compiler",
    "bytecode", "auditStatus"
  ],
  "properties": {
    "schema": { "const": "agentpay.settlement-authority-controller-deployment.v1" },
    "status": { "enum": ["candidate", "canonical", "retired"] },
    "protocol": { "const": "agentpay.settlement-authority-controller.v1" },
    "abiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "chainId": { "$ref": "#/$defs/uintString" },
    "network": { "type": "string", "pattern": "^eip155:[1-9][0-9]*$" },
    "controllerAddress": { "$ref": "#/$defs/address" },
    "administratorSafe": { "$ref": "#/$defs/address" },
    "factoryAddress": { "$ref": "#/$defs/address" },
    "initialExecutor": { "$ref": "#/$defs/address" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "deploymentTxHash": { "$ref": "#/$defs/bytes32" },
    "deploymentBlockNumber": { "$ref": "#/$defs/uintString" },
    "deployedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solc", "optimizer", "optimizerRuns", "viaIR", "evmVersion"],
      "properties": {
        "solc": { "type": "string" },
        "optimizer": { "type": "boolean" },
        "optimizerRuns": { "type": "integer", "minimum": 0 },
        "viaIR": { "type": "boolean" },
        "evmVersion": { "type": "string" }
      }
    },
    "bytecode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creationKeccak256", "runtimeKeccak256"],
      "properties": {
        "creationKeccak256": { "$ref": "#/$defs/bytes32" },
        "runtimeKeccak256": { "$ref": "#/$defs/bytes32" }
      }
    },
    "auditStatus": { "enum": ["not-audited", "audit-in-progress", "audited"] }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "uintString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
  }
}
